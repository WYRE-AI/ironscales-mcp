{
  "name": "@wyre-ai/ironscales-mcp",
  "version": "1.0.1",
  "description": "MCP server for Ironscales — phishing incident management, email classification, and remediation",
  "type": "module",
  "main": "./dist/index.js",
  "scripts": {
    "build": "tsup",
    "build:ui": "vite build && node scripts/embed-ui.mjs",
    "dev": "tsup --watch",
    "start": "node dist/index.js",
    "start:http": "MCP_TRANSPORT=http node dist/http.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint src/",
    "typecheck": "tsc --noEmit",
    "mcpb:pack": "npm run build && npm install --production && mcpb pack",
    "cf:deploy": "npm run build && wrangler deploy",
    "cf:dev": "npm run build && wrangler dev"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.1"
  },
  "devDependencies": {
    "@anthropic-ai/mcpb": "^2.1.0",
    "@eslint/js": "^10.0.1",
    "@modelcontextprotocol/ext-apps": "^2.0.3",
    "@semantic-release/changelog": "^7.0.0",
    "@semantic-release/git": "^11.0.1",
    "@semantic-release/github": "^12.0.10",
    "@types/node": "^26.6.4",
    "eslint": "^10.11.0",
    "globals": "^17.13.0",
    "msw": "^3.0.1",
    "semantic-release": "^25.0.9",
    "tsup": "^8.0.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.71.0",
    "vite": "^8.3.2",
    "vite-plugin-singlefile": "^2.3.3",
    "vitest": "^5.0.3",
    "wrangler": "^4.147.0"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/WYRE-AI/ironscales-mcp.git"
  },
  "license": "MIT",
  "publishConfig": {
    "access": "restricted"
  }
}
